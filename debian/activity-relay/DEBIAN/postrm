#!/bin/sh
set -e

if [ "$1" = "purge" ]; then
    echo "Activity-Relay identity, local configuration, website content, and Redis data were retained."
    echo "Remove them manually only after confirming that backups are usable."
fi

# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = remove ] && [ -d /run/systemd/system ] ; then
	systemctl --system daemon-reload >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "purge" ]; then
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper purge 'activity-relay-redis.service' 'activity-relay-resource-guard.timer' 'activity-relay-server.service' 'activity-relay-worker.service' >/dev/null || true
	fi
fi
# End automatically added section


exit 0
