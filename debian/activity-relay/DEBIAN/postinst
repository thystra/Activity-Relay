#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    install -d -o root -g root -m 0755 /var/lib/activity-relay
    if ! getent passwd activity-relay >/dev/null; then
        adduser --system --group --home /var/lib/activity-relay \
            --no-create-home activity-relay
    fi

    install -d -o root -g root -m 0755 /etc/activity-relay
    install -d -o redis -g redis -m 0700 /var/lib/activity-relay/redis
    install -d -o activity-relay -g activity-relay -m 0750 /var/cache/activity-relay
    install -d -o root -g root -m 0750 /var/lib/activity-relay-guard
    install -d -o root -g root -m 0755 /etc/activity-relay-web
    install -d -o root -g root -m 0755 /var/www/activity-relay/public

    if [ ! -e /etc/activity-relay/actor.pem ]; then
        relay generate-key --output /etc/activity-relay/actor.pem
    fi
    chown activity-relay:activity-relay /etc/activity-relay/actor.pem
    chmod 0600 /etc/activity-relay/actor.pem

    if [ -z "$2" ]; then
        echo ""
        echo "Activity-Relay was installed but not enabled or started."
        echo "Copy and edit /etc/activity-relay/config.yml.example as config.yml."
        echo "The actor identity is at /etc/activity-relay/actor.pem."
        echo "Web-server examples are under /usr/share/doc/activity-relay/examples/."
        echo "The generated website root is /var/www/activity-relay/public."
        echo "See /usr/share/doc/activity-relay/README.Debian for setup steps."
    fi
fi

# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'activity-relay-redis.service'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'activity-relay-redis.service' >/dev/null || true

		if deb-systemd-helper --quiet was-enabled 'activity-relay-redis.service'; then
			# Create new symlinks, if any.
			deb-systemd-helper enable 'activity-relay-redis.service' >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be cleaned
	# up on purge. Also remove old symlinks.
	deb-systemd-helper update-state 'activity-relay-redis.service' >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'activity-relay-resource-guard.timer'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'activity-relay-resource-guard.timer' >/dev/null || true

		if deb-systemd-helper --quiet was-enabled 'activity-relay-resource-guard.timer'; then
			# Create new symlinks, if any.
			deb-systemd-helper enable 'activity-relay-resource-guard.timer' >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be cleaned
	# up on purge. Also remove old symlinks.
	deb-systemd-helper update-state 'activity-relay-resource-guard.timer' >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'activity-relay-server.service'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'activity-relay-server.service' >/dev/null || true

		if deb-systemd-helper --quiet was-enabled 'activity-relay-server.service'; then
			# Create new symlinks, if any.
			deb-systemd-helper enable 'activity-relay-server.service' >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be cleaned
	# up on purge. Also remove old symlinks.
	deb-systemd-helper update-state 'activity-relay-server.service' >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'activity-relay-worker.service'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'activity-relay-worker.service' >/dev/null || true

		if deb-systemd-helper --quiet was-enabled 'activity-relay-worker.service'; then
			# Create new symlinks, if any.
			deb-systemd-helper enable 'activity-relay-worker.service' >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be cleaned
	# up on purge. Also remove old symlinks.
	deb-systemd-helper update-state 'activity-relay-worker.service' >/dev/null || true
fi
# End automatically added section


if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null || true
    if [ -n "$2" ]; then
        echo ""
        if deb-systemd-invoke try-restart activity-relay-redis.service \
            activity-relay-server.service activity-relay-worker.service \
            activity-relay-resource-guard.timer >/dev/null 2>&1; then
            echo "Activity-Relay upgrade complete; active services were restarted."
        else
            echo "Warning: Activity-Relay was upgraded, but one or more active services could not be restarted." >&2
            echo "Check them with: systemctl --failed 'activity-relay-*'" >&2
        fi
    fi
fi

exit 0
