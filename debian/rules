#!/usr/bin/make -f

export DH_VERBOSE = 1
export CGO_ENABLED = 0

%:
	dh $@

override_dh_auto_build:
	mkdir -p debian/build
	APP_VERSION="$$(dpkg-parsechangelog -SVersion | sed -e 's/^[0-9][0-9]*://' -e 's/-[^-]*$$//' -e 's/~/-/g')"; \
		go build -trimpath -ldflags "-s -w -X main.version=$$APP_VERSION" -o debian/build/relay .

override_dh_auto_test:
	# Redis-backed tests run in CI before package assembly.
	true

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade

override_dh_clean:
	dh_clean
	rm -rf debian/build
