# Generic Nginx template for Activity-Relay with an optional frontend.
#
# When using the bundled site, its output directory must match the root
# directive below. Build a native/package installation with:
#
#   /etc/activity-relay-web/rebuild-site.sh
#
# Nginx serves those generated files. The landing-page JavaScript requests
# /status.json, which Nginx proxies to the Go relay backend.
#
# Replace relay.example.org, certificate paths, log paths, root, and backend
# address as needed.

upstream activity_relay_backend {
    server 127.0.0.1:8080;
    keepalive 16;
}

# Per-source admission controls. Put these in the http context if this file is
# included from inside a server block on your distribution.
limit_req_zone $binary_remote_addr zone=relay_inbox_rate:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=relay_per_source:10m;

server {
    listen 80;
    listen [::]:80;
    server_name relay.example.org;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    # Optional HTTP/3/QUIC support. Enable only when `nginx -V` includes
    # --with-http_v3_module and UDP port 443 is allowed through every firewall.
    # Keep the TCP listeners above for HTTP/1.1 and HTTP/2 fallback.
    # listen 443 quic reuseport;
    # listen [::]:443 quic reuseport;
    # http3 on;
    # quic_retry on;
    # add_header Alt-Svc 'h3=":443"; ma=86400' always;

    server_name relay.example.org;

    ssl_certificate     /etc/letsencrypt/live/relay.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay.example.org/privkey.pem;

    # Optional local hardening include:
    # include /etc/nginx/snippets/block-sensitive-probes.conf;

    # This must match build-site.py --output.
    root /var/www/activity-relay/public;
    index index.html;

    client_max_body_size 1M;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    location = /inbox {
        limit_req zone=relay_inbox_rate burst=60 nodelay;
        limit_conn relay_per_source 20;
        limit_req_status 429;
        limit_conn_status 429;
        proxy_pass http://activity_relay_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location = /actor {
        proxy_pass http://activity_relay_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Live dashboard data from the Go relay. This exact match takes
    # precedence over the static location / block below.
    location = /status.json {
        proxy_pass http://activity_relay_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /.well-known/nodeinfo {
        proxy_pass http://activity_relay_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /.well-known/webfinger {
        proxy_pass http://activity_relay_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /nodeinfo/2.1 {
        proxy_pass http://activity_relay_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend choice 1, enabled by default: bundled generated website.
    location /assets/ {
        try_files $uri =404;
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Frontend choice 2: no public frontend. Comment out the two blocks above
    # and enable this instead:
    #
    # location / {
    #     return 404;
    # }

    # Frontend choice 3: redirect only the root page. Comment out the two
    # bundled-site blocks above and enable both locations:
    #
    # location = / {
    #     return 302 https://example.org/about-this-relay;
    # }
    #
    # location / {
    #     return 404;
    # }

    # Frontend choice 4: custom site. Change root to the custom document root
    # and retain the active try_files location. Keep every exact relay endpoint
    # location above proxied to activity_relay_backend.

    access_log /var/log/nginx/activity-relay.access.log combined;
    error_log  /var/log/nginx/activity-relay.error.log warn;
}
