# Published image used by compose.yml.
# Use a full release-candidate tag while testing a prerelease.
ACTIVITY_RELAY_IMAGE=ghcr.io/thystra/activity-relay:2.4.0-rc4

# Publish the Go API only on loopback when a host reverse proxy is used.
# Set RELAY_PUBLISH_ADDRESS=0.0.0.0 only when direct remote access is intended.
RELAY_PUBLISH_ADDRESS=127.0.0.1
RELAY_HTTP_PORT=8080

# Number of worker replicas requested by Docker Compose.
WORKER_REPLICAS=2

# Single-disk VPS defaults. Relative paths keep a checkout self-contained;
# production operators may replace them with absolute host paths.
RELAY_STORAGE_DIR=./redisdata
RELAY_CACHE_DIR=./cache

# Redis uses noeviction so writes fail instead of deleting relay metadata.
REDIS_MAXMEMORY=512mb
REDIS_CONTAINER_MEMORY=768m
SERVER_MEMORY_LIMIT=512m
WORKER_MEMORY_LIMIT=512m

# Per-container bounded local logs (approximately size x files).
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=5
