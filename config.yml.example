ACTOR_PEM: /var/lib/relay/actor.pem
REDIS_URL: redis://redis:6379

RELAY_BIND: 0.0.0.0:8080
# Optional separate metrics and probe listener; disabled when unset.
# Keep it on a private container network and do not publish it publicly.
# OBSERVABILITY_BIND: 0.0.0.0:9090
RELAY_DOMAIN: relay.example.org
RELAY_SERVICENAME: Community ActivityPub Relay
JOB_CONCURRENCY: 50
MAX_ACTIVITY_BYTES: 1048576
MAX_FANOUT_TARGETS: 5000
MAX_QUEUE_JOBS: 100000
# Outbound authorized-fetch GET and delivery POST signature profile.
# Supported values: legacy, rfc9421, and dual. Empty or omitted preserves
# legacy. dual uses expiring destination capability evidence, permits at most
# one GET fallback after an explicit legacy Signature challenge, and never
# retries a delivery POST under another profile.
OUTBOUND_SIGNATURE_PROFILE: legacy
# Controls which broadly addressable activities enter public relay fan-out.
# explicit_public_only relays only when Public is in the primary `to` field.
# public_and_unlisted also relays when Public appears only in `cc`, preserving
# pre-3.0 behavior. Neither value makes followers-only or direct activities
# eligible unless they are explicitly addressed to the relay through another
# supported protocol path.
PUBLIC_ADDRESS_DISTRIBUTION_POLICY: explicit_public_only

# Optional Activity-Relay Directory entries. The list is absent by default and
# each entry is independently disabled unless explicitly enabled. The scheduler
# gate is also off by default and is honored only by the API server process.
DIRECTORY_SCHEDULER_ENABLED: false
# DIRECTORIES:
#   - origin: https://directory.example.org
#     enabled: false

# Single-disk defaults used by contrib/ops/resource-guard.py. These should
# match RELAY_STORAGE_DIR and RELAY_CACHE_DIR in the deployment environment.
STORAGE_DIR: /var/lib/activity-relay/redis
CACHE_DIR: /var/cache/activity-relay

# Limits accept plain bytes, decimal units (KB, MB, GB, TB), or binary units
# (KiB, MiB, GiB, TiB). Units are case-insensitive; decimals such as 1.5GB work.
STORAGE_LIMIT: 10GB
CACHE_LIMIT: 1GB
STORAGE_REQUIRE_MOUNT: false
CACHE_REQUIRE_MOUNT: false
RESOURCE_WARNING_PERCENT: 75
RESOURCE_CRITICAL_PERCENT: 100

ADMIN_EMAIL: root
MAIL_BACKEND: mail
MAIL_COMMAND: /usr/bin/mail
# Abort a blocked local mail submission instead of blocking future timer runs.
MAIL_TIMEOUT_SECONDS: 60
# MAIL_BACKEND: sendmail
# MAIL_COMMAND: /usr/sbin/sendmail

# Optional scheduled operational summaries.
#
# Times use the server's local timezone and zero-padded 24-hour HH:MM format.
# Each configured time is an independent daily slot and sends at most once.
# The five-minute resource-guard timer processes a due slot on its first run at
# or after the configured time, so delivery may be several minutes later.
#
# If several slots were missed during downtime, only the most recent due slot
# is mailed. The catch-up email records the skipped slots and explains how to
# inspect or reset them. Successful report bodies are archived in the guard
# state directory.
DAILY_SUMMARY_EMAIL: false
DAILY_SUMMARY_TIMES:
  - "08:00"
# Deprecated single-time settings. Ignored when DAILY_SUMMARY_TIMES is present.
# DAILY_SUMMARY_HOUR: 8
# DAILY_SUMMARY_MINUTE: 0
SUMMARY_STATUS_URL: http://127.0.0.1:8080/status.json

# Optional split-storage example. STORAGE_MOUNT_POINT lets the monitor validate
# the parent mount while Redis uses a dedicated child directory.
# STORAGE_DIR: /mnt/activity-relay-nas/redis
# STORAGE_LIMIT: 50GB
# STORAGE_REQUIRE_MOUNT: true
# STORAGE_MOUNT_POINT: /mnt/activity-relay-nas

# RELAY_SUMMARY: |
# Optional public relay branding. These are interoperability recommendations,
# not protocol limits; clients may crop or rescale the supplied images.
# RELAY_ICON: square logo/avatar; 512x512 px recommended (128x128 minimum).
# Keep important icon content centered and use a public HTTPS URL.
# RELAY_ICON: https://relay.example.org/assets/relay-icon.png
# RELAY_IMAGE: wide header/banner; 1500x500 px (3:1) recommended.
# Public fediverse contact shown in the optional website footer.
# The underscore spelling is canonical. Hyphenated aliases are accepted
# by the static-site builder only for backward compatibility.
# FEDIVERSE_OPERATOR_ID: "@operator@social.example"
# Optional explicit profile URL. This cannot be derived reliably from a handle
# because profile URL layouts differ among fediverse server applications.
# FEDIVERSE_OPERATOR_URL: "https://social.example/@operator"

# Keep important banner content away from the outer edges.
# RELAY_IMAGE: https://relay.example.org/assets/relay-banner.webp
